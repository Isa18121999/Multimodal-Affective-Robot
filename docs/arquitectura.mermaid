graph TD
    subgraph "Percepción multimodal"
        A[📷 Cámara] --> B[Detección de presencia y captura facial]
        C[🎤 Micrófono] --> D[Reconocimiento de voz]
        E[📡 Sensor de proximidad] --> F[Detección de interacción]
    end

    subgraph "Fusión emocional"
        B --> G[Señal facial]
        D --> H[Señal de voz / texto]
        G --> I[MultimodalEmotionFusion]
        H --> I
        I --> J[Chuwi Emotional Manager]
    end

    subgraph "Cognición e interacción"
        J --> K[Personalidad adaptativa]
        K --> L[Chuwi AI Engine]
        L --> M[Respuesta conversacional]
        M --> N[TTS / Audio]
    end

    subgraph "Persistencia y supervisión"
        J --> O[Sesión emocional]
        M --> P[Registro de interacción]
        P --> Q[(PostgreSQL)]
        O --> Q
    end

    subgraph "APIs externas"
        B --- R[Google Gemini\nAnálisis facial]
        L --- S[Groq / LLaMA\nGeneración conversacional]
        N --- T[Edge TTS / TTS externo]
    end

    subgraph "Hardware de salida"
        N --> U[🔊 Altavoz]
    end

    U --> V[Chuwi - robot de peluche]

    style V fill:#f5f5f5,stroke:#555
